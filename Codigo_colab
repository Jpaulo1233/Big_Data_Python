import seaborn as sns
import matplotlib.pyplot as plt

colunas = ["Feminicídio", "Tentativa de feminicídio"]

# totais mensais do estado (uma linha por mês)
mes = df.groupby(["Ano", "Mês"])[colunas].sum().reset_index()
mes["rotulo"] = mes["Mês"].astype(str).str.zfill(2) + "/" + mes["Ano"].astype(str)

fig, eixos = plt.subplots(1, 2, figsize=(11, 5.5))

for ax, c in zip(eixos, colunas):
    sns.boxplot(data=mes[c], ax=ax)

    # limites do boxplot (regra de 1,5 x IQR)
    q1, q3 = mes[c].quantile([0.25, 0.75])
    iqr = q3 - q1
    sup, inf = q3 + 1.5 * iqr, q1 - 1.5 * iqr

    # meses outliers
    outliers = mes[(mes[c] > sup) | (mes[c] < inf)]
    for _, linha in outliers.iterrows():
        ax.annotate(f"{linha['rotulo']} ({int(linha[c])})",
                    xy=(0, linha[c]), xytext=(0.12, linha[c]),
                    va="center", fontsize=9,
                    arrowprops=dict(arrowstyle="-", color="gray", lw=0.6))

    ax.set_xlim(-0.4, 0.6)
    ax.set_title(f"{c} (total mensal)\nlimites: {inf:.1f} a {sup:.1f}")
    ax.set_ylabel(c)
    ax.set_xticks([])
    print(c, "->", outliers[["rotulo", c]].values.tolist())

plt.tight_layout()
plt.show()

